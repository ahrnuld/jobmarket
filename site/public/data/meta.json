:"Rijnmond"},"parent":"p:zuid-holland"},{"id":"r:noord-holland-noord","level":"region","name":{"nl":"Noord-Holland Noord","en":"Noord-Holland Noord"},"parent":"p:noord-holland"},{"id":"r:twente","level":"region","name":{"nl":"Twente","en":"Twente"},"parent":"p:overijssel"},{"id":"r:flevoland","level":"region","name":{"nl":"Flevoland","en":"Flevoland"},"parent":"p:flevoland"},{"id":"r:holland-rijnland","level":"region","name":{"nl":"Holland Rijnland","en":"Holland Rijnland"},"parent":"p:zuid-holland"},{"id":"r:midden-brabant","level":"region","name":{"nl":"Midden-Brabant","en":"Midden-Brabant"},"parent":"p:noord-brabant"},{"id":"r:amersfoort","level":"region","name":{"nl":"Amersfoort","en":"Amersfoort"},"parent":"p:utrecht"},{"id":"r:stedendriehoek","level":"region","name":{"nl":"Veluwe Stedendriehoek","en":"Veluwe Stedendriehoek"},"parent":"p:gelderland"},{"id":"r:midden-gelderland","level":"region","name":{"nl":"Midden-Gelderland","en":"Midden-Gelderland"},"parent":"p:gelderland"},{"id":"r:helmond-de-peel","level":"region","name":{"nl":"Helmond-De Peel","en":"Helmond-De Peel"},"parent":"p:noord-brabant"},{"id":"r:food-valley","level":"region","name":{"nl":"FoodValley","en":"FoodValley"},"parent":"p:gelderland"},{"id":"r:zuid-limburg","level":"region","name":{"nl":"Zuid-Limburg","en":"Zuid-Limburg"},"parent":"p:limburg"},{"id":"r:zaanstreek-waterland","level":"region","name":{"nl":"Zaanstreek/Waterland","en":"Zaanstreek/Waterland"},"parent":"p:noord-holland"},{"id":"r:noord-limburg","level":"region","name":{"nl":"Noord-Limburg","en":"Noord-Limburg"},"parent":"p:limburg"},{"id":"r:rijk-van-nijmegen","level":"region","name":{"nl":"Rijk van Nijmegen","en":"Rijk van Nijmegen"},"parent":"p:gelderland"},{"id":"r:midden-holland","level":"region","name":{"nl":"Midden-Holland","en":"Midden-Holland"},"parent":"p:zuid-holland"},{"id":"r:zuidoost-brabant","level":"region","name":{"nl":"Zuidoost-Brabant","en":"Zuidoost-Brabant"},"parent":"p:noord-brabant"},{"id":"r:noordoost-brabant","level":"region","name":{"nl":"Noordoost-Brabant","en":"Noordoost-Brabant"},"parent":"p:noord-brabant"},{"id":"r:zuid-kennemerland-ijmond","level":"region","name":{"nl":"Zuid-Kennemerland en IJmond","en":"Zuid-Kennemerland en IJmond"},"parent":"p:noord-holland"},{"id":"r:gooi-vechtstreek","level":"region","name":{"nl":"Gooi en Vechtstreek","en":"Gooi en Vechtstreek"},"parent":"p:noord-holland"},{"id":"r:drenthe","level":"region","name":{"nl":"Drenthe","en":"Drenthe"},"parent":"p:drenthe"},{"id":"r:zeeland","level":"region","name":{"nl":"Zeeland","en":"Zeeland"},"parent":"p:zeeland"},{"id":"r:midden-utrecht","level":"region","name":{"nl":"Midden-Utrecht","en":"Midden-Utrecht"},"parent":"p:utrecht"},{"id":"r:rivierenland","level":"region","name":{"nl":"Rivierenland","en":"Rivierenland"},"parent":"p:gelderland"},{"id":"r:midden-limburg","level":"region","name":{"nl":"Midden-Limburg","en":"Midden-Limburg"},"parent":"p:limburg"},{"id":"r:regio-zwolle","level":"region","name":{"nl":"Regio Zwolle","en":"Regio Zwolle"},"parent":"p:overijssel"},{"id":"r:haaglanden","level":"region","name":{"nl":"Haaglanden","en":"Haaglanden"},"parent":"p:zuid-holland"},{"id":"r:gorinchem","level":"region","name":{"nl":"Gorinchem","en":"Gorinchem"},"parent":"p:zuid-holland"},{"id":"r:zuid-holland-centraal","level":"region","name":{"nl":"Zuid-Holland Centraal","en":"Zuid-Holland Centraal"},"parent":"p:zuid-holland"}],"changelog":[{"date":"2026-09-20","version":"0.6.0","title":{"nl":"Tweede vacaturebron: EURES (UWV) naast Adzuna","en":"A second vacancy source: EURES (UWV) next to Adzuna"},"body":{"nl":"Naast Adzuna halen we nu ook vacatures uit EURES, het vacatureportaal van de Europese Commissie, waar de Nederlandse vacatures van UWV vandaan komen. Dat levert ongeveer driemaal zoveel ICT-vacatures per dag, de volledige vacaturetekst in plaats van de eerste 500 tekens, en per vacature een gebied, waardoor bijna alle EURES-vacatures op de kaart staan. Een vacature die in beide bronnen staat, tellen we één keer. Omdat het totaal hierdoor stijgt zonder dat de arbeidsmarkt veranderde, zijn de maanden van vóór deze uitbreiding niet met latere maanden te vergelijken; ze staan als onvolledig gemarkeerd en tellen niet mee in trends.","en":"Besides Adzuna we now also collect vacancies from EURES, the European Commission's job portal, whose Dutch vacancies come from UWV. That yields about three times as many ICT vacancies a day, the full vacancy text instead of the first 500 characters, and an area per vacancy, so nearly every EURES vacancy appears on the map. A vacancy present in both sources is counted once. Because the total rises without the job market changing, the months before this addition cannot be compared with later ones; they are marked incomplete and are left out of trends."},"series_break":["vacancies","skills","salaries","regions"]},{"date":"2026-09-20","version":"0.5.0","title":{"nl":"Percentage stage + junior eerlijker berekend; onvolledige maanden gemarkeerd","en":"A fairer internship + junior percentage, and incomplete months marked"},"body":{"nl":"Het percentage stage + junior werd afgezet tegen alle vacatures, terwijl ongeveer twee derde van de vacatures geen niveau noemt. Daardoor leek het aandeel starters veel kleiner dan het is: 5% in plaats van 13% van de vacatures die wel een niveau noemen. We rekenen nu af tegen die laatste groep; hoeveel vacatures geen niveau noemen staat er als apart cijfer naast. Verder markeren we maanden die al voorbij waren toen we met dagelijks ophalen begonnen als onvolledig, omdat we daarvan alleen de advertenties hebben die toen nog online stonden; ze tellen niet mee in trends. Een lopende maand wordt nu wel elke dag bijgewerkt: eerder kon die blijven staan op de stand van de eerste dag.","en":"The internship + junior percentage was expressed against all vacancies, while about two thirds of them state no level. That made the share of starter roles look far smaller than it is: 5% instead of 13% of the vacancies that do state a level. We now express it against that group, with the number of vacancies without a level beside it. We also mark months that were already over when the daily collection started as incomplete, because we only have the ads that were still online then; they are left out of trends. A running month is now updated every day: it could previously stay frozen at the count of its first day."},"series_break":["seniority"]},{"date":"2026-09-20","version":"0.4.0","title":{"nl":"Elke dag vacatures ophalen in plaats van elke week","en":"Collecting vacancies daily instead of weekly"},"body":{"nl":"Een vacature staat soms maar een paar dagen online. Met een wekelijkse ophaalronde misten we die; vanaf nu halen we elke dag de vacatures van de afgelopen twee dagen op. Verder terugkijken dan de start van de reeks kan niet: de bron levert alleen vacatures die nu nog online staan, en daarvan is na een maand nog ongeveer 30% over en na een half jaar ongeveer 5%. Tellingen over die maanden zouden dus een daling laten zien die er nooit was. Wat we alsnog uit het verleden ophalen, gebruiken we daarom alleen om de indeelregels te controleren.","en":"A vacancy is sometimes online for only a few days. A weekly collection round missed those; from now on we collect the vacancies of the past two days every day. Looking further back than the start of the series is not possible: the source only serves vacancies still online, of which about 30% remain after a month and about 5% after six months. Counts for those months would show a decline that never happened. Anything we do collect from the past is therefore used only to check the classification rules."},"series_break":[]},{"date":"2026-09-20","version":"0.3.0","title":{"nl":"Meervoudige functietitels tellen mee; officiele verdeling per provincie erbij","en":"Plural job titles now count; official spread per province added"},"body":{"nl":"Advertenties met een meervoudige titel (\"Software Engineers\", \"Business Analisten\") werden niet aan een opleiding gekoppeld en soms helemaal niet als ICT-vacature herkend, omdat de regels in het enkelvoud staan. Meervoudsvormen van functiewoorden tellen nu mee. Verder halen we de CBS-cijfers over openstaande vacatures in de sector Informatie en communicatie voor alle twaalf provincies op, zodat onze verdeling naast de officiele verdeling staat, en beschrijft de methode hoe compleet de kaart is.","en":"Ads with a plural title (\"Software Engineers\", \"Business Analisten\") were not linked to a programme, and sometimes not recognised as an ICT vacancy at all, because the rules are written in the singular. Plural forms of role nouns now count. We also collect the CBS figures on open vacancies in the Information and communication sector for all twelve provinces, so our spread sits next to the official one, and the method describes how complete the map is."},"series_break":[]},{"date":"2026-09-20","version":"0.2.0","title":{"nl":"Regio-indeling van het CBS en een kaart per COROP-gebied","en":"CBS area classification and a map per COROP area"},"body":{"nl":"De koppeling van een vacature aan een regio liep eerst via een met de hand gemaakte gemeentelijst die alleen voor Noord-Holland compleet was. Nu gebruiken we de gebiedsindelingen van het CBS (2010 tot nu): elke gemeentenaam, ook die van opgeheven gemeenten zoals Naarden en Sneek, hoort bij een COROP-gebied, een arbeidsmarktregio en een provincie. Daardoor krijgen vacatures buiten Noord-Holland alsnog een regio, en liggen de regiocijfers van eerdere maanden hoger dan eerder getoond. Nieuw is de kaart met het aantal vacatures per COROP-gebied.","en":"Linking a vacancy to a region used to run through a hand-made municipality list that was complete for Noord-Holland only. We now use the CBS area classifications (2010 to now): every municipality name, including those of abolished municipalities such as Naarden and Sneek, belongs to a COROP area, a labour market region and a province. Vacancies outside Noord-Holland therefore now get a region, and the regional figures for earlier months are higher than shown before. New is the map with the number of vacancies per COROP area."},"series_break":["regions"]},{"date":"2026-09-19","version":"0.1.0","title":{"nl":"Eerste versie van de methode","en":"First version of the method"},"body":{"nl":"Eerste opzet van ontdubbeling, seniorityclassificatie, koppeling aan opleidingen en skill-extractie, bijgesteld op basis van de eerste 30 dagen Adzuna-data. Adzuna levert alleen de eerste ~500 tekens van een vacaturetekst; skills en ervaringseisen die later in de tekst staan worden dus niet gezien. Stagevergoedingen worden apart geteld en niet gemengd met salarissen. Nog niet getoetst op een handmatig gelabelde steekproef.","en":"First version of deduplication, seniority classification, programme mapping and skill extraction, revised against the first 30 days of Adzuna data. Adzuna provides only the first ~500 characters of a posting, so skills and experience requirements further down the text are not seen. Internship allowances are counted separately and never mixed with salaries. Not yet measured against a manually labelled sample."},"series_break":[]}],"accuracy":null,"validation":{"ok":true,"errors":[],"warnings":["Licence terms of source adzuna not checked (terms_checked_on in sources.yaml).","Licence terms of source eures not checked (terms_checked_on in sources.yaml).","Licence terms of source cbs not checked (terms_checked_on in sources.yaml).","Licence terms of source studiekeuze123 not checked (terms_checked_on in sources.yaml).","Licence terms of source esco not checked (terms_checked_on in sources.yaml).","61 ESCO links not yet checked by hand.","Classification accuracy not yet measured on a labelled sample (TR-05)."]}}