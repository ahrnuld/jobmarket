---
// Served by nginx for unknown paths. Bilingual, because the language is unknown here.
import "../styles/global.css";
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pagina niet gevonden · Page not found</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="wrap prose">
      <h1>Pagina niet gevonden</h1>
      <p>Deze pagina bestaat niet (meer). <a href="/nl/">Naar het overzicht</a></p>
      <h2 lang="en">Page not found</h2>
      <p lang="en">This page does not exist (anymore). <a href="/en/">Go to the overview</a></p>
    </main>
  </body>
</html>
